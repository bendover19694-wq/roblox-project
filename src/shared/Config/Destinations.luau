--!strict
-- Destinations. Map positions are stylised (scale 0..1 of the map area), not astronomy.
-- demand = units wanting to fly per trip · fare = per unit at Standard · competition = share rivals take

export type Destination = {
	id: string,
	name: string,
	code: string,
	distance: number,
	demand: number,
	fare: number,
	competition: number,
	kind: string, -- Tourists | Satellites | Cargo | Science
	stage: number,
	pos: Vector2,
	size: number, -- body diameter in px at 1080p
	color: Color3,
	color2: Color3,
	ring: boolean?,
}

local function c(hex: string): Color3
	return Color3.fromHex(hex)
end

