					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Main</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">381b40c13496960b0b10fc580000a952</UniqueId>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX902944B726E14A73A4558E1925BDC923">
				<Properties>
					<Content name="ExplorerIconContent">
						<null></null>
					</Content>
					<Color3 name="IconTint">
						<R>0</R>
						<G>0</G>
						<B>0</B>
					</Color3>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Services</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">381b40c13496960b0b10fc580000a954</UniqueId>
				</Properties>
				<Item class="ModuleScript" referent="RBX8494E9184BD74AD6BE68BE6F52B7C060">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Player profiles in DataStores with a simple session lock.
-- ponytail: lock-in-record via UpdateAsync (no cross-server lock handoff). If players report
-- "progress not saving" after server hops, upgrade to ProfileStore (see docs/design.md).
-- Outage mode: if loading fails, the player still plays, but saving is off and the HUD says so.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)

type Profile = any

local DataService = {}

local LOCK_TTL = 180 -- seconds; autosave refreshes the lock well before this
local AUTOSAVE = 60
local JOB = if game.JobId ~= "" then game.JobId else "studio"

local entries: { [Player]: { data: Profile, canSave: boolean } } = {}
local loadedSignal = Instance.new("BindableEvent")
local swappedSignal = Instance.new("BindableEvent")
DataService.swapped = swappedSignal.Event -- fires (player) when a late load replaces the stand-in profile

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("ClipEmpire_v1")
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable (unpublished place?): ", result)
	end
end

local function key(player: Player): string
	return `Player_{player.UserId}` -- matches the RTBF deletion template
end

-- Studio with API access off: every DataStore call fails with this, so retrying only delays the first screen.
local studioBlocked = false

local function tryLoad(player: Player): Profile?
	if not store then
		return nil
	end
	local blocked = false
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key(player), function(old)
			local lock = type(old) == "table" and old._lock
			if lock and lock.job ~= JOB and os.time() - lock.at < LOCK_TTL then
				blocked = true
				return nil -- another server still owns this profile
			end
			local data = Economy.migrate(old)
			do
				local it = data :: any
				it._lock = { job = JOB, at = os.time() }
			end
			return data
		end)
	end)
	if not ok then
		warn("[DataService] load failed: ", result)
		if tostring(result):find("StudioAccessToApisNotAllowed", 1, true) then
			studioBlocked = true
		end
		return nil
	end
	if blocked then
		return nil
	end
	return Economy.migrate(result)
end

function DataService.load(player: Player)
	local data: Profile? = nil
	for _ = 1, 5 do
		data = tryLoad(player)
		if data or not player.Parent or not store or studioBlocked then
			break -- no DataStores at all (unpublished place / outage): play unsaved right away
		end
		task.wait(3)
	end
	if not player.Parent then
		-- Left while we were still loading: PlayerRemoving already ran, so release the lock we may hold.
		if data then
			entries[player] = { data = data, canSave = true }
			DataService.save(player, true)
			entries[player] = nil
		end
		return
	end
	local standIn = Economy.default()
	-- A real DataStore that failed to load (held lock or outage) most likely means a returning player:
	-- don't replay the tutorial. Studio without DataStores still gets it, for testing.
	standIn.tutorialDone = store ~= nil and not studioBlocked
	entries[player] = { data = data or standIn, canSave = data ~= nil }
	player:SetAttribute("ReducedMotion", entries[player].data.settings.reducedMotion)
	player:SetAttribute("Sound", entries[player].data.settings.sound ~= false)
	player:SetAttribute("CanSave", data ~= nil)
	loadedSignal:Fire(player)
	if data or not store or studioBlocked then
		return
	end
	-- Another server may still hold the lock (fast server hop or a crash). Keep trying until it expires,
	-- then swap the real profile in. Progress made on the stand-in is dropped, and the HUD says so.
	task.spawn(function()
		local t0 = os.clock()
		while player.Parent and os.clock() - t0 < LOCK_TTL + 30 do
			task.wait(10)
			local late = tryLoad(player)
			if late and not player.Parent then
				-- Loaded after they left: give the lock straight back.
				entries[player] = { data = late, canSave = true }
				DataService.save(player, true)
				entries[player] = nil
				return
			end
			if late then
				entries[player] = { data = late, canSave = true }
				player:SetAttribute("ReducedMotion", late.settings.reducedMotion)
				player:SetAttribute("Sound", late.settings.sound ~= false)
				player:SetAttribute("CanSave", true)
				swappedSignal:Fire(player)
				return
			end
		end
	end)
end

-- Saves; `release` drops the session lock (on leave / shutdown). Returns true only when the data is stored.
function DataService.save(player: Player, release: boolean?): boolean
	local entry = entries[player]
	if not entry or not entry.canSave or not store then
		return false
	end
	local written = false
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(key(player), function(old)
			written = false -- the transform can run more than once; only the last run counts
			local lock = type(old) == "table" and old._lock
			if lock and lock.job ~= JOB then
				return nil -- lost the lock to another server; don't overwrite its data
			end
			local out = table.clone(entry.data) :: any
			out._lock = if release then nil else { job = JOB, at = os.time() }
			written = true
			return out
		end)
	end)
	if not ok then
		warn("[DataService] save failed: ", err)
	end
	return ok and written
end

-- Returns the live profile (mutate it, then call save at a checkpoint). Waits for load.
function DataService.get(player: Player): Profile?
	while not entries[player] and player.Parent do
		loadedSignal.Event:Wait()
	end
	local entry = entries[player]
	return entry and entry.data
end

function DataService.peek(player: Player): Profile?
	local entry = entries[player]
	return entry and entry.data
end

function DataService.start()
	Players.PlayerAdded:Connect(DataService.load)
	for _, p in Players:GetPlayers() do
		task.spawn(DataService.load, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		for attempt = 1, 3 do
			if DataService.save(player, true) or not (entries[player] and entries[player].canSave) then
				break
			end
			task.wait(attempt * 2)
		end
		entries[player] = nil
	end)
	game:BindToClose(function()
		local pending = 0
		for player in entries do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for player in entries do
				task.spawn(DataService.save, player)
			end
		end
	end)
end

return DataService
]]></ProtectedString>
						<string name="ScriptGuid">{CFADBD03-A967-48B2-B5C9-2AC383BEE8FF}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">DataService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">381b40c13496960b0b10fc580000a955</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX7E5D528755614F1BB7868A03FFE6114D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- The core loop on the server: tap and auto-clip, post for cash and followers, buy upgrades,
-- rebirth for Clout. The server owns every number; the client only asks.

local AnalyticsService = game:GetService("AnalyticsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Net = require(ReplicatedStorage.Shared.Net)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local GameService = {}

local rng = Random.new()
local tapLimit, forgetTap = Net.limiter(4, 6) -- tap batches per second (client sends ~2/s)
local actLimit, forgetAct = Net.limiter(6, 10)
local SETTINGS = { reducedMotion = true, sound = true }
local ACTIONS = { post = true, buy = true, rebirth = true, setting = true, tutorialDone = true }

-- Per-player session state that is never saved.
type Session = {
	tapBudget: number,
	budgetAt: number,
	dirty: boolean,
	zone: number,
	funnel: { [string]: boolean },
}
local sessions: { [Player]: Session } = {}

local FUNNEL =
	{ "joined", "first_tap", "first_post", "first_upgrade", "zone_2", "first_rebirth", "tutorial_skipped" }
-- Steps that only mean "first ever" while the tutorial is still running (veterans would re-fire them).
local TUTORIAL_STEPS = { first_tap = true, first_post = true, first_upgrade = true }

local function funnel(player: Player, step: string)
	local s = sessions[player]
	if not s or s.funnel[step] then
		return
	end
	local p = DataService.peek(player)
	if TUTORIAL_STEPS[step] and p and p.tutorialDone then
		return
	end
	if step == "first_rebirth" and p and p.rebirths ~= 1 then
		return
	end
	s.funnel[step] = true
	local index = table.find(FUNNEL, step) or 0
	print(`[Funnel] {player.Name} {index} {step}`)
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, index, step)
	end)
end

-- Zone the character stands in, limited to what the player has unlocked.
local function currentZone(player: Player, p: Economy.Profile): number
	local unlocked = Economy.unlockedZone(p.followers)
	local char = player.Character
	-- lihfolk-ignore: findfirstchild-chain (result is nil-checked on the next line)
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return 1
	end
	local at = Economy.zoneAt(root.Position.X, root.Position.Z)
	return math.clamp(at or 1, 1, unlocked)
end

local function view(player: Player, p: Economy.Profile)
	local s = sessions[player]
	local hypeOn, hypeLeft = Economy.hype(os.time())
	local zone = s and s.zone or 1
	local costs = {}
	for id in Config.UPGRADES do
		costs[id] = Economy.nextCost(p, id) or -1 -- -1 = maxed (remotes drop nil holes)
	end
	return {
		cash = p.cash,
		clips = p.clips,
		capacity = Economy.capacity(p),
		followers = p.followers,
		clout = p.clout,
		rebirths = p.rebirths,
		rebirthCost = Economy.rebirthCost(p),
		levels = p.levels,
		costs = costs,
		tapPower = Economy.tapPower(p),
		autoRate = Economy.autoRate(p),
		viralChance = Economy.viralChance(p),
		clipValue = Economy.clipValue(p, zone, hypeOn),
		zone = zone,
		unlocked = Economy.unlockedZone(p.followers),
		hypeOn = hypeOn,
		hypeLeft = hypeLeft,
		tutorialDone = p.tutorialDone,
		canSave = player:GetAttribute("CanSave") == true,
		settings = p.settings,
	}
end

local function push(player: Player)
	local p = DataService.peek(player)
	if p then
		Remotes.State:FireClient(player, view(player, p))
	end
end

local function markDirty(player: Player)
	local s = sessions[player]
	if s then
		s.dirty = true
	end
end

function GameService.post(player: Player, p: Economy.Profile): (boolean, string?)
	if p.clips < 1 then
		return false, "No clips yet. Tap CLIP first"
	end
	local s = sessions[player]
	local zone = s and s.zone or 1
	local hypeOn = Economy.hype(os.time())
	local cash, followers, viral = Economy.post(p, zone, hypeOn, rng:NextNumber())
	local before = Economy.unlockedZone(p.followers - followers)
	Remotes.Celebrate:FireClient(player, "post", { cash = cash, followers = followers, viral = viral })
	local after = Economy.unlockedZone(p.followers)
	if after > before then
		Remotes.Celebrate:FireClient(player, "zone", { index = after })
		if after >= 2 then
			funnel(player, "zone_2")
		end
	end
	funnel(player, "first_post")
	markDirty(player)
	return true, nil
end

local handlers: { [string]: (Player, Economy.Profile, any) -> (boolean, string?) } = {
	post = function(player, p)
		return GameService.post(player, p)
	end,
	buy = function(player, p, id)
		if not Net.isEnum(id, Config.UPGRADE_IDS) then
			return false, "Bad upgrade"
		end
		local ok, why = Economy.buy(p, id)
		if ok then
			funnel(player, "first_upgrade")
			markDirty(player)
		end
		return ok, why
	end,
	rebirth = function(player, p)
		local ok, why = Economy.rebirth(p)
		if ok then
			Remotes.Celebrate:FireClient(player, "rebirth", { clout = p.clout })
			funnel(player, "first_rebirth")
			markDirty(player)
			task.spawn(DataService.save, player) -- checkpoint a big reset right away
		end
		return ok, why
	end,
	setting = function(player, p, name)
		if not Net.isEnum(name, SETTINGS) then
			return false, "Bad setting"
		end
		local settings = p.settings :: any
		settings[name] = not settings[name]
		player:SetAttribute(if name == "reducedMotion" then "ReducedMotion" else "Sound", settings[name])
		markDirty(player)
		return true, nil
	end,
	tutorialDone = function(player, p, how)
		if how == "skip" and not p.tutorialDone then
			funnel(player, "tutorial_skipped")
		end
		p.tutorialDone = true
		markDirty(player)
		return true, nil
	end,
}

local function onAct(player: Player, action: any, arg: any): (boolean, string?)
	if not actLimit(player) then
		return false, "Slow down"
	end
	if not Net.isEnum(action, ACTIONS) then
		return false, "Bad action"
	end
	local p = DataService.peek(player)
	if not p then
		return false, "Loading"
	end
	local ran, ok, why = pcall(handlers[action], player, p, arg)
	if not ran then
		warn(`[GameService] {action} failed: {ok}`)
		ok, why = false, "Something went wrong. Try again"
	end
	push(player)
	return ok, why
end

local function onTap(player: Player, count: any)
	if not tapLimit(player) or not Net.isInt(count, 1, Config.TAP_BATCH_MAX) then
		return
	end
	local p = DataService.peek(player)
	local s = sessions[player]
	if not p or not s then
		return
	end
	-- Budget refills at the human tap ceiling; anything above it is dropped.
	local now = os.clock()
	s.tapBudget =
		math.min(Config.TAP_PER_SECOND_CAP * 2, s.tapBudget + (now - s.budgetAt) * Config.TAP_PER_SECOND_CAP)
	s.budgetAt = now
	local taps = math.min(count, math.floor(s.tapBudget))
	if taps <= 0 then
		return
	end
	s.tapBudget -= taps
	if Economy.addClips(p, taps * Economy.tapPower(p)) > 0 then
		funnel(player, "first_tap")
		markDirty(player)
	end
end

function GameService.start()
	Remotes.Act.OnServerInvoke = onAct
	Remotes.Tap.OnServerEvent:Connect(onTap)

	Players.PlayerAdded:Connect(function(player)
		sessions[player] = { tapBudget = 0, budgetAt = os.clock(), dirty = true, zone = 1, funnel = {} }
		funnel(player, "joined")
		task.spawn(function()
			DataService.get(player) -- waits for load
			push(player)
		end)
	end)
	for _, player in Players:GetPlayers() do
		sessions[player] = { tapBudget = 0, budgetAt = os.clock(), dirty = true, zone = 1, funnel = {} }
	end
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
		forgetTap(player)
		forgetAct(player)
	end)
	DataService.swapped:Connect(function(player)
		Remotes.Toast:FireClient(player, "Your save loaded. Welcome back!", "info")
		push(player)
	end)

	-- One shared loop: auto clips, zone tracking, auto post, state push when changed.
	task.spawn(function()
		local lastHype = Economy.hype(os.time())
		while true do
			local dt = task.wait(Config.AUTO_TICK)
			local hypeOn = Economy.hype(os.time())
			local hypeChanged = hypeOn ~= lastHype
			if hypeChanged and hypeOn then
				Remotes.Toast:FireAllClients(
					`{Config.HYPE_GAME} TRAILER DROP! Clips pay x{Config.HYPE_MULT}`,
					"hype"
				)
			end
			lastHype = hypeOn
			for player, s in sessions do
				local p = DataService.peek(player)
				if p then
					local zone = currentZone(player, p)
					if zone ~= s.zone then
						s.zone = zone
						s.dirty = true
					end
					local rate = Economy.autoRate(p)
					if rate > 0 and Economy.addClips(p, rate * dt) > 0 then
						s.dirty = true
					end
					if (p.levels.autoPost or 0) > 0 and p.clips >= Economy.capacity(p) then
						GameService.post(player, p)
					end
					if s.dirty or hypeChanged then
						s.dirty = false
						push(player)
					end
				end
			end
		end
	end)
end

return GameService
]]></ProtectedString>
						<string name="ScriptGuid">{4F66BDD6-6F5D-428C-8E8E-DD75EDA0B72B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">GameService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">381b40c13496960b0b10fc580000a957</UniqueId>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBXA3FD9279446E4C3C8F6FC82FF23AB389">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Builds the neon street at server start: five creator setups along X, gates, a skyline and lighting.
-- Parts and built-in materials, plus optional free Creator Store props saved in ServerStorage.Props
-- (scripts stripped, see docs/assets.md). Missing props fall back to parts, so the map always builds.

local Lighting = game:GetService("Lighting")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local World = {}

local Props = game:GetService("ServerStorage"):FindFirstChild("Props")

-- Clones a saved prop so its bounding-box bottom centre sits at `at`, scaled to `height` studs.
local function prop(name: string, parent: Instance, at: CFrame, height: number): Model?
	local src = Props and Props:FindFirstChild(name)
	if not (src and src:IsA("Model")) then
		return nil
	end
	local m = src:Clone()
	local _, size = m:GetBoundingBox()
	if size.Y > 0 then
		m:ScaleTo(m:GetScale() * height / size.Y)
	end
	local box, newSize = m:GetBoundingBox()
	local offset = m:GetPivot():ToObjectSpace(box)
	m:PivotTo(at * CFrame.new(0, newSize.Y / 2, 0) * offset:Inverse())
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	m.Parent = parent
	return m
end

local W, D = Config.ZONE_WIDTH, Config.ZONE_DEPTH
local LENGTH = W * #Config.ZONES

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function label(parent: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg or Color3.new(0, 0, 0)
	t.BackgroundTransparency = if bg then 0 else 1
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.Text = text
	t.Parent = gui
	gui.Parent = parent
end

local function lighting()
	Lighting.ClockTime = 19.1 -- dusk: neon reads, but buildings are still visible
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(110, 90, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 120, 180)
	Lighting.EnvironmentDiffuseScale = 0.4
	local atmos = Instance.new("Atmosphere")
	atmos.Density = 0.32
	atmos.Color = Color3.fromRGB(255, 120, 190)
	atmos.Decay = Color3.fromRGB(90, 40, 140)
	atmos.Glare = 0.4
	atmos.Haze = 1.6
	atmos.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.9
	bloom.Size = 30
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.08
	cc.TintColor = Color3.fromRGB(255, 240, 250)
	cc.Parent = Lighting
end

-- A creator desk: desk, chair, two monitors (one live, one showing the hype trailer), ring light.
local function setup(parent: Instance, cx: number, color: Color3, tier: number)
	local desk = part(parent, {
		Name = "Desk",
		Size = Vector3.new(14, 1, 6),
		Position = Vector3.new(cx, 4, 14),
		Color = Color3.fromRGB(30, 30, 40),
	})
	for _, dx in { -6, 6 } do
		part(parent, {
			Size = Vector3.new(1, 3.5, 5),
			Position = desk.Position + Vector3.new(dx, -2.25, 0),
			Color = desk.Color,
		})
	end
	part(parent, {
		Size = Vector3.new(14, 0.2, 0.3),
		Position = desk.Position + Vector3.new(0, 0.5, -3),
		Material = Enum.Material.Neon,
		Color = color,
	})
	local screens = math.clamp(tier, 1, 3)
	for i = 1, screens do
		local x = cx + (i - (screens + 1) / 2) * 5.2
		local mon = part(parent, {
			Name = "Monitor",
			Size = Vector3.new(5, 3, 0.4),
			Position = Vector3.new(x, 6.6, 16),
			Color = Color3.fromRGB(10, 10, 14),
		})
		local text = if i == 1
			then `{Config.HYPE_GAME}\nTRAILER`
			elseif i == 2 then "LIVE  REC"
			else "CLIPS\nUPLOADING"
		label(
			mon,
			Enum.NormalId.Front,
			text,
			Color3.new(1, 1, 1),
			if i == 2 then Color3.fromRGB(200, 30, 60) else Color3.fromRGB(20, 16, 40)
		)
		part(
			parent,
			{ Size = Vector3.new(0.4, 1.6, 0.4), Position = Vector3.new(x, 5.2, 16), Color = desk.Color }
		)
	end
	-- Chair: the free gaming chair when saved, else a simple part chair.
	if not prop("Chair2", parent, CFrame.new(cx, 0.4, 9) * CFrame.Angles(0, math.pi, 0), 6) then
		part(parent, { Size = Vector3.new(3, 0.6, 3), Position = Vector3.new(cx, 2.6, 9), Color = color })
		part(parent, { Size = Vector3.new(3, 3.5, 0.6), Position = Vector3.new(cx, 4.6, 7.4), Color = color })
	end
	-- Ring light
	local ring = part(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 4, 4),
		Position = Vector3.new(cx + 9, 8, 12),
		Orientation = Vector3.new(0, 90, 0),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 245, 230),
	})
	part(parent, {
		Size = Vector3.new(0.3, 6, 0.3),
		Position = ring.Position - Vector3.new(0, 4.5, 0),
		Color = desk.Color,
	})
	local light = Instance.new("PointLight")
	light.Range = 22
	light.Brightness = 1.2
	light.Color = color
	light.Parent = ring
end

local function gate(parent: Instance, index: number)
	local z = Config.ZONES[index]
	local x = (index - 1) * W
	local folder = Instance.new("Model")
	folder.Name = `Gate{index}`
	for _, side in { -1, 1 } do
		part(folder, {
			Size = Vector3.new(2, 22, 2),
			Position = Vector3.new(x, 11, side * (D / 2 - 1)),
			Material = Enum.Material.Neon,
			Color = z.color,
		})
	end
	local top = part(folder, {
		Name = "Sign",
		Size = Vector3.new(2, 6, D),
		Position = Vector3.new(x, 25, 0),
		Color = Color3.fromRGB(20, 16, 40),
	})
	label(top, Enum.NormalId.Left, `{string.upper(z.name)}  x{z.mult}`, z.color)
	label(top, Enum.NormalId.Right, `{string.upper(z.name)}  x{z.mult}`, z.color)
	-- Wall: the client makes it solid while locked for that player (server keeps it open for everyone).
	local wall = part(folder, {
		Name = "Wall",
		Size = Vector3.new(1, 22, D - 4),
		Position = Vector3.new(x, 11, 0),
		Material = Enum.Material.ForceField,
		Color = z.color,
		Transparency = 0.2,
		CanCollide = false,
	})
	wall:SetAttribute("Zone", index)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Lock"
	bb.Size = UDim2.fromOffset(200, 56)
	bb.StudsOffset = Vector3.new(0, -5, 0) -- below the HUD's stat pills from the usual camera angle
	bb.AlwaysOnTop = false
	bb.MaxDistance = 60
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.3
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.Text = `LOCKED\nNeed {z.followers} followers`
	t.Parent = bb
	bb.Parent = wall
	folder.Parent = parent
end

local function skyline(parent: Instance)
	local rng = Random.new(66)
	local palette = {
		Color3.fromRGB(255, 80, 170),
		Color3.fromRGB(60, 200, 255),
		Color3.fromRGB(255, 190, 60),
		Color3.fromRGB(170, 100, 255),
	}
	local posters = {
		`{Config.HYPE_GAME}\nOUT SOON`,
		"CLIP IT\nPOST IT",
		"GO VIRAL",
		`{Config.HYPE_GAME}\nTRAILER 3`,
		"1M VIEWS\nCLUB",
	}
	local n = 0
	for _, side in { -1, 1 } do
		local x = -60
		while x < LENGTH + 60 do
			local w = rng:NextInteger(18, 30)
			local h = rng:NextInteger(40, 140)
			local z = side * (D / 2 + 20 + rng:NextInteger(0, 20))
			local b = part(parent, {
				Name = "Building",
				Size = Vector3.new(w, h, 24),
				Position = Vector3.new(x + w / 2, h / 2, z),
				Color = Color3.fromRGB(
					rng:NextInteger(22, 40),
					rng:NextInteger(18, 30),
					rng:NextInteger(40, 60)
				),
				Material = Enum.Material.Concrete,
			})
			local accent = palette[rng:NextInteger(1, #palette)]
			for y = 12, h - 6, 14 do
				part(parent, {
					Size = Vector3.new(w - 4, 2, 0.4),
					Position = Vector3.new(b.Position.X, y, z - side * 12.2),
					Material = Enum.Material.Neon,
					Color = accent,
					Transparency = 0.15,
					CanCollide = false,
				})
			end
			n += 1
			if n % 3 == 0 then
				local poster = part(parent, {
					Size = Vector3.new(w - 2, 14, 0.5),
					Position = Vector3.new(b.Position.X, math.min(h - 10, 30), z - side * 12.5),
					Color = Color3.fromRGB(15, 10, 30),
					CanCollide = false,
				})
				label(
					poster,
					if side < 0 then Enum.NormalId.Back else Enum.NormalId.Front,
					posters[(n // 3 - 1) % #posters + 1],
					accent
				)
			end
			x += w + rng:NextInteger(2, 8)
		end
	end
end

local function palm(parent: Instance, pos: Vector3)
	part(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(16, 1.6, 1.6),
		Position = pos + Vector3.new(0, 8, 0),
		Orientation = Vector3.new(0, 0, 90),
		Color = Color3.fromRGB(110, 80, 60),
		Material = Enum.Material.Wood,
	})
	for i = 0, 5 do
		part(parent, {
			Size = Vector3.new(1, 0.4, 8),
			CFrame = CFrame.new(pos + Vector3.new(0, 16, 0))
				* CFrame.Angles(0, math.rad(i * 60), 0)
				* CFrame.Angles(math.rad(-25), 0, 0)
				* CFrame.new(0, 0, -3.5),
			Color = Color3.fromRGB(40, 170, 90),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
end

function World.build()
	lighting()
	local root = Instance.new("Folder")
	root.Name = "World"

	part(root, {
		Name = "Ground",
		Size = Vector3.new(LENGTH + 400, 2, 400),
		Position = Vector3.new(LENGTH / 2, -1, 0),
		Color = Color3.fromRGB(24, 22, 32),
		Material = Enum.Material.Asphalt,
	})
	-- Lane stripes
	for x = -40, LENGTH + 40, 16 do
		part(root, {
			Size = Vector3.new(8, 0.1, 0.6),
			Position = Vector3.new(x, 0.05, -D / 2 - 8),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 220, 120),
			CanCollide = false,
		})
	end
	-- Spawn plaza behind zone 1
	part(root, {
		Name = "Plaza",
		Size = Vector3.new(40, 0.4, D),
		Position = Vector3.new(-20, 0.2, 0),
		Color = Color3.fromRGB(45, 40, 60),
	})
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.Position = Vector3.new(-12, 0.5, 0)
	spawn.Orientation = Vector3.new(0, -90, 0) -- face +X, down the street
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = Enum.Material.Neon
	spawn.Color = Color3.fromRGB(255, 92, 168)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = root
	local end_ = part(root, {
		Name = "EndWall",
		Size = Vector3.new(2, 30, D),
		Position = Vector3.new(LENGTH + 1, 15, 0),
		Transparency = 1,
	})
	end_.CanCollide = true
	part(root, {
		Name = "BackWall",
		Size = Vector3.new(2, 30, D),
		Position = Vector3.new(-41, 15, 0),
		Transparency = 1,
	})
	for _, side in { -1, 1 } do
		part(root, {
			Name = "Rail",
			Size = Vector3.new(LENGTH + 42, 30, 2),
			Position = Vector3.new(LENGTH / 2 - 20, 15, side * (D / 2 + 1)),
			Transparency = 1,
		})
	end

	for i, z in Config.ZONES do
		local cx = (i - 1) * W + W / 2
		local zone = Instance.new("Model")
		zone.Name = `Zone{i}`
		part(zone, {
			Name = "Floor",
			Size = Vector3.new(W - 2, 0.4, D),
			Position = Vector3.new(cx, 0.2, 0),
			Color = Color3.fromRGB(34, 30, 48),
		})
		part(zone, {
			Size = Vector3.new(W - 2, 0.2, 1),
			Position = Vector3.new(cx, 0.45, D / 2 - 1),
			Material = Enum.Material.Neon,
			Color = z.color,
		})
		part(zone, {
			Size = Vector3.new(W - 2, 0.2, 1),
			Position = Vector3.new(cx, 0.45, -D / 2 + 1),
			Material = Enum.Material.Neon,
			Color = z.color,
		})
		setup(zone, cx, z.color, i)
		if i >= 3 then
			setup(zone, cx - 26, z.color, i - 1)
			setup(zone, cx + 26, z.color, i - 1)
		end
		local sign = part(zone, {
			Name = "ZoneSign",
			Size = Vector3.new(30, 8, 1),
			Position = Vector3.new(cx, 14, 24),
			Color = Color3.fromRGB(15, 10, 30),
		})
		label(sign, Enum.NormalId.Front, `{z.name}\nCLIPS PAY x{z.mult}`, z.color)
		palm(zone, Vector3.new(cx - 30, 0, -24))
		palm(zone, Vector3.new(cx + 30, 0, -24))
		zone.Parent = root
		if i >= 2 then
			gate(root, i)
		end
	end

	-- The hype screen at the end of the street.
	local screen = part(root, {
		Name = "HypeScreen",
		Size = Vector3.new(2, 40, 60),
		Position = Vector3.new(LENGTH - 2, 26, 0),
		Color = Color3.fromRGB(10, 8, 20),
	})
	label(
		screen,
		Enum.NormalId.Left,
		`{Config.HYPE_GAME}\nOFFICIAL TRAILER\nCLIP IT FIRST`,
		Color3.fromRGB(255, 200, 80),
		Color3.fromRGB(30, 10, 50)
	)

	-- Street lamps along both kerbs (free prop when saved, else a neon post).
	for x = 15, LENGTH - 10, 30 do
		for _, side in { -1, 1 } do
			local at = CFrame.new(x, 0.4, side * (D / 2 - 4))
				* CFrame.Angles(0, if side > 0 then 0 else math.pi, 0)
			local lamp = prop("Lamp2", root, at, 14)
			local top = if lamp
				then lamp:GetBoundingBox().Position + Vector3.new(0, 6, 0)
				else Vector3.new(x, 13, side * (D / 2 - 4))
			if not lamp then
				part(root, {
					Size = Vector3.new(0.6, 13, 0.6),
					Position = Vector3.new(x, 6.5, side * (D / 2 - 4)),
					Color = Color3.fromRGB(30, 30, 40),
				})
			end
			local bulb = part(root, {
				Name = "LampLight",
				Size = Vector3.new(1, 1, 1),
				Position = top,
				Transparency = 1,
				CanCollide = false,
			})
			local light = Instance.new("PointLight")
			light.Range = 24
			light.Brightness = 1.4
			light.Color = Color3.fromRGB(255, 210, 150)
			light.Parent = bulb
		end
	end

	skyline(root)
	root.Parent = workspace
end

return World
