						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Uploaded UI art.
-- Buttons (v2): exact vector plates generated by scripts/buttons/make_buttons.py (SVG rendered by
-- headless Chrome), Vice-sunset palette, leaning 8 degrees like the owner's Store reference. Text is not baked in: `label` is the box (fractions of the
-- image, x0, y0, x1, y1) where Kit.imageButton draws the live label.
-- Icons: Antigravity art (Agent HQ task t_be0c31c715f5), cut with scripts/cut_magenta.py.
-- aspect = width / height of the PNG, so art keeps its shape at any size.

export type ArtItem = { id: string, aspect: number, label: { number }?, mask: string? }

local WIDE_LABEL = { 0.30, 0.19, 0.91, 0.71 }
-- White face silhouettes for the shine sweep (same geometry as the plates).
local WIDE_MASK = "rbxassetid://123680994777980"
local LAUNCHER_MASK = "rbxassetid://90760782294635"
local LAUNCHER_LABEL = { 0.335, 0.2, 0.925, 0.7 }

return {
	clip = { id = "rbxassetid://135389216143178", aspect = 2.6, label = WIDE_LABEL, mask = WIDE_MASK },
	post = { id = "rbxassetid://139049560082029", aspect = 2.6, label = WIDE_LABEL, mask = WIDE_MASK },
	upgrades = {
		id = "rbxassetid://127859667315483",
		aspect = 2.3,
		label = LAUNCHER_LABEL,
		mask = LAUNCHER_MASK,
	},
	goViral = {
		id = "rbxassetid://83170794353824",
		aspect = 2.3,
		label = LAUNCHER_LABEL,
		mask = LAUNCHER_MASK,
	},
	settings = {
		id = "rbxassetid://107410531199691",
		aspect = 2.3,
		label = LAUNCHER_LABEL,
		mask = LAUNCHER_MASK,
	},
	coin = { id = "rbxassetid://99607466522493", aspect = 0.949 },
	followers = { id = "rbxassetid://82147027167811", aspect = 0.949 },
	clout = { id = "rbxassetid://110646073067698", aspect = 0.961 },
	reel = { id = "rbxassetid://120147774122892", aspect = 0.949 },
} :: { [string]: ArtItem }
]]></ProtectedString>
						<string name="ScriptGuid">{1A69E42D-E8F3-4D9C-8E2D-3BFA032F14F1}</string>
