				<Item class="ModuleScript" referent="RBX5E777BAD228F486997C1AA4C7E90F2BD">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- The HUD: stats on top, menu on the left, CLIP and POST at the bottom, and three panels.
-- Groups are sized in a 1000x560 design space and scaled to the real screen by one UIScale value.
-- Design text is 21+ so it renders at 12 px or more on the smallest phone (iPhone 14 HUD: 749x330, scale 0.59).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Art = require(script.Parent.Art)
local Kit = require(script.Parent.Kit)
local Panels = require(script.Parent.Panels)

local C = Kit.colors
local Hud = {}

export type Actions = {
	tap: () -> (),
	post: () -> (),
	buy: (id: string) -> (),
	rebirth: () -> (),
	setting: (name: string) -> (),
	skipTutorial: () -> (),
}

function Hud.build(actions: Actions)
	local gui = Kit.make("ScreenGui", {
		Name = "ClipHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local scales: { UIScale } = {}
	local function group(name: string, anchor: Vector2, pos: UDim2, size: Vector2): Frame
		local f = Kit.make("Frame", {
			Name = name,
			AnchorPoint = anchor,
			Position = pos,
			Size = UDim2.fromOffset(size.X, size.Y),
			BackgroundTransparency = 1,
			Parent = gui,
		})
		table.insert(scales, Kit.make("UIScale", { Parent = f }))
		return f
	end
	local toastArea: Frame
	local toastLayout: UIListLayout
	local openName: string? = nil
	local function placeToasts()
		local s = gui:GetAttribute("UiScale") or 1
		-- Below the top stats normally; while a panel is open they wait in a queue (see api.toast).
		toastArea.Position = UDim2.new(0.5, 0, 0, 146 * s)
		toastLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	end
	local function rescale()
		local v = gui.AbsoluteSize
		local s = math.clamp(math.min(v.X / 1000, v.Y / 560), 0.5, 1.1)
		for _, sc in scales do
			sc.Scale = s
		end
		gui:SetAttribute("UiScale", s)
		placeToasts()
	end

	-- Top: stat pills, hype banner, zone chip.
	local top = group("Top", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 6), Vector2.new(700, 138))
	local Icons =
		require(game:GetService("ReplicatedStorage"):WaitForChild("LihFolkUI"):WaitForChild("LihFolkUIIcons"))
	-- Antigravity art feeds the kit's icon registry, so pills and kit buttons share one icon set.
	Icons.registerMany({
		cash = Art.coin.id,
		followers = Art.followers.id,
		star = Art.clout.id,
		timer = Art.reel.id,
	})
	local function pill(
		name: string,
		x: number,
		w: number,
		color: Color3,
		caption: string,
		icon: string
	): TextLabel
		local f = Kit.make("Frame", {
			Name = name,
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(w, 62),
			BackgroundColor3 = C.bg,
			BackgroundTransparency = 0.1,
			Parent = top,
		}, { Kit.corner(31), Kit.stroke(Kit.colors.stroke, 3) })
		Kit.make("UIStroke", {
			Color = color,
			Thickness = 2,
			Parent = Kit.make("Frame", {
				Size = UDim2.new(1, -6, 1, -6),
				Position = UDim2.fromOffset(3, 3),
				BackgroundTransparency = 1,
				Parent = f,
			}, { Kit.corner(28) }),
		})
		-- Icon art comes from the registry (Antigravity icons once uploaded), else the kit's drawn fallback.
		local glyph = Icons.make(icon, UDim2.fromOffset(44, 44)) -- untinted: the art carries its own colours
		glyph.Position = UDim2.fromOffset(9, 9)
		glyph.Parent = f
		Kit.text({
			Text = caption,
			Size = UDim2.new(1, -72, 0, 22),
			Position = UDim2.fromOffset(60, 3),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = color,
			Font = Kit.BODY,
			max = 21,
			Parent = f,
		})
		return Kit.text({
			Name = "Value",
			Text = "0",
			Size = UDim2.new(1, -72, 0, 34),
			Position = UDim2.fromOffset(60, 25),
			TextXAlignment = Enum.TextXAlignment.Left,
			max = 32,
			Parent = f,
		})
	end
	local cashText = pill("Cash", 0, 232, C.green, "CASH", "cash")
	local followersText = pill("Followers", 240, 268, C.blue, "FOLLOWERS", "followers")
	local cloutText = pill("Clout", 516, 184, C.purple, "CLOUT", "star")
	local banner = Kit.make("Frame", {
		Name = "Hype",
		Position = UDim2.fromOffset(40, 70),
		Size = UDim2.fromOffset(620, 32),
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.25,
		Parent = top,
	}, { Kit.corner(15) })
	local bannerStroke = Kit.stroke(C.gold, 2)
	bannerStroke.Parent = banner
	local hypeText = Kit.text({
		Text = "",
		Size = UDim2.new(1, -20, 1, -4),
		Position = UDim2.fromOffset(10, 2),
		max = 22,
		Font = Kit.BODY,
		Parent = banner,
	})
	local zoneText = Kit.text({
		Name = "Zone",
		Text = "",
		Size = UDim2.fromOffset(620, 28),
		Position = UDim2.fromOffset(40, 106),
		max = 22,
		Font = Kit.BODY,
		Parent = top,
	})

	-- Menus come from the LihFolk UI kit (Panels.luau); these image launchers open them.
	local left = group("Menu", Vector2.new(0, 0.5), UDim2.new(0, 10, 0.44, 0), Vector2.new(264, 361)) -- clear of the phone thumbstick
	Kit.make(
		"UIListLayout",
		{ Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = left }
	)
	local launchers: { [string]: ImageButton } = {}
	local LAUNCHERS = {
		{ name = "Upgrades", art = Art.upgrades, label = "UPGRADES" },
		{ name = "Rebirth", art = Art.goViral, label = "GO VIRAL" },
		{ name = "Settings", art = Art.settings, label = "SETTINGS" },
	}
	for i, spec in LAUNCHERS do
		launchers[spec.name] = Kit.imageButton({
			Name = "Open" .. spec.name,
			Size = UDim2.fromOffset(264, 115), -- 68 px tall on the smallest phone; label fits at 12 px
			Label = spec.label,
			LabelMax = 30,
			LayoutOrder = i,
			Parent = left,
		}, spec.art, function() end) -- the kit's bindOpener does the opening
	end
	local badge = Kit.make("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -30, 0, -6),
		BackgroundColor3 = C.red,
		Visible = false,
		ZIndex = 5,
		Parent = launchers.Upgrades,
	}, { Kit.corner(20), Kit.stroke(Kit.colors.stroke, 3) })
	Kit.text({ Text = "!", Size = UDim2.fromScale(1, 1), max = 30, ZIndex = 6, Parent = badge })
	local bottom: Frame
	local flushToasts: () -> ()

	-- Bottom: storage bar, CLIP and POST.
	bottom = group("Actions", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -10), Vector2.new(560, 236))
	local objective = Kit.make("Frame", {
		Name = "Objective",
		Size = UDim2.fromOffset(520, 40),
		Position = UDim2.fromOffset(20, 0),
		BackgroundColor3 = C.gold,
		Visible = false,
		Parent = bottom,
	}, { Kit.corner(20), Kit.stroke(Color3.new(1, 1, 1), 2) })
	local objectiveText = Kit.text({
		Text = "",
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		max = 26,
		Parent = objective,
	})
	local bar = Kit.make("Frame", {
		Name = "Storage",
		Size = UDim2.fromOffset(520, 34),
		Position = UDim2.fromOffset(20, 48),
		BackgroundColor3 = C.bg,
		Parent = bottom,
	}, { Kit.corner(17), Kit.stroke(C.pink, 2) })
	local fill = Kit.make(
		"Frame",
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.pink, Parent = bar },
		{ Kit.corner(17) }
	)
	local barText = Kit.text({
		Text = "CLIPS 0 / 0",
		Size = UDim2.new(1, -20, 1, -6),
		Position = UDim2.fromOffset(10, 3),
		max = 22,
		ZIndex = 2,
		Parent = bar,
	})
	local clipBtn = Kit.imageButton({
		Name = "Clip",
		Label = "CLIP",
		Shine = 3.5,
		Size = UDim2.fromOffset(270, 104),
		Position = UDim2.fromOffset(5, 96),
		Parent = bottom,
	}, Art.clip, actions.tap)
	local postBtn = Kit.imageButton({
		Name = "Post",
		Label = "POST",
		Shine = 4.5,
		Size = UDim2.fromOffset(270, 104),
		Position = UDim2.fromOffset(285, 96),
		Parent = bottom,
	}, Art.post, actions.post)
	local info = Kit.text({
		Text = "",
		Size = UDim2.fromOffset(560, 24),
		Position = UDim2.fromOffset(0, 210),
		max = 21,
		Font = Kit.BODY,
		TextColor3 = C.dim,
		Parent = bottom,
	})

	local panelUi = Panels.build(actions)
	for name, button in launchers do
		panelUi.bindOpener(button, name)
	end
	-- While a menu is open the action bar hides and toasts wait, so nothing covers the menu.
	local KitController = require(
		game:GetService("ReplicatedStorage"):WaitForChild("LihFolkUI"):WaitForChild("LihFolkUIController")
	)
	KitController.onChanged(function()
		openName = KitController.getCurrent()
		bottom.Visible = openName == nil
		left.Visible = openName == nil -- menus are modal (dimmer, close button, B); on phones they would overlap
		if openName == nil then
			flushToasts()
		end
	end)

	-- Toasts and floating numbers sit above everything except open panels.
	toastArea = group("Toasts", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 146), Vector2.new(600, 150))
	toastLayout = Kit.make("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = toastArea,
	})
	local fx = group("Fx", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.42), Vector2.new(700, 200))

	local api = {}
	local last: any = nil

	-- Just the storage bar: cheap enough to run on every tap.
	function api.updateClips(s: any)
		local ratio = if s.capacity > 0 then math.clamp(s.clips / s.capacity, 0, 1) else 0
		Kit.tween(fill, 0.15, { Size = UDim2.fromScale(ratio, 1) })
		local full = s.clips >= s.capacity
		postBtn:SetAttribute("Pulse", full) -- a full drive makes POST breathe
		barText.Text = if full
			then `DRIVE FULL {Format.short(s.clips)} / {Format.short(s.capacity)}: POST!`
			else `CLIPS {Format.short(s.clips)} / {Format.short(s.capacity)}`
		fill.BackgroundColor3 = if full then C.gold else C.pink
	end

	function api.update(s: any)
		last = s
		cashText.Text = Format.money(s.cash)
		followersText.Text = Format.short(s.followers)
		cloutText.Text = `{s.clout}  (x{1 + Config.CLOUT_MULT * s.clout})`
		local zone = Config.ZONES[s.zone]
		zoneText.Text = `{zone.name}: clips pay x{zone.mult}`
		zoneText.TextColor3 = zone.color
		if s.hypeOn then
			hypeText.Text = `TRAILER DROP! x{Config.HYPE_MULT} cash: {Format.duration(s.hypeLeft)} left`
			bannerStroke.Color = C.gold
			banner.BackgroundColor3 = Color3.fromRGB(90, 50, 10)
		else
			hypeText.Text = `Next trailer drop in {Format.duration(s.hypeLeft)}`
			bannerStroke.Color = C.dim
			banner.BackgroundColor3 = C.bg
		end
		api.updateClips(s)
		local per = if s.clipValue < 100
			then string.format("$%.2f", s.clipValue):gsub("%.?0+$", "")
			else Format.money(s.clipValue)
		info.Text =
			`+{Format.short(s.tapPower)}/tap   {string.format("%.1f", s.autoRate)}/s   {per}/clip   {math.floor(
				s.viralChance * 1000
			) / 10}% viral`
		-- "!" when an upgrade is affordable; never during the tutorial (first-session rule).
		badge.Visible = panelUi.update(s) and s.tutorialDone == true
	end

	local queued: { { any } } = {}
	function api.toast(text: string, kind: string?)
		if openName then
			-- Toasts never cover a panel; they wait and show when it closes (newest 2 kept).
			table.insert(queued, { text, kind or "info" } :: { any })
			if #queued > 2 then -- the toast area shows two at a time
				table.remove(queued, 1)
			end
			return
		end
		local color = if kind == "hype" then C.gold elseif kind == "error" then C.red else C.blue
		local t = Kit.make(
			"Frame",
			{ Size = UDim2.fromOffset(560, 76), BackgroundColor3 = C.bg, Parent = toastArea },
			{ Kit.corner(23), Kit.stroke(color, 3) }
		)
		Kit.text({
			Text = text,
			Size = UDim2.new(1, -24, 1, -10),
			Position = UDim2.fromOffset(12, 5),
			max = 24,
			Font = Kit.BODY,
			Parent = t,
		})
		local items = toastArea:GetChildren()
		local frames = 0
		for _, c in items do
			if c:IsA("Frame") then
				frames += 1
			end
		end
		if frames > 2 then
			for _, c in items do
				if c:IsA("Frame") and c ~= t then
					c:Destroy()
					break
				end
			end
		end
		task.delay(2.6, function()
			t:Destroy()
		end)
	end

	flushToasts = function()
		local q = queued
		queued = {}
		for _, item in q do
			api.toast(item[1], item[2])
		end
	end

	-- Floating text that rises and fades. Skipped motion keeps the text, without the rise.
	function api.float(text: string, color: Color3, size: number)
		if openName then
			return -- effects never sit on top of a panel
		end
		local t = Kit.text({
			Text = text,
			Size = UDim2.fromOffset(700, size),
			Position = UDim2.fromOffset(0, 100),
			TextColor3 = color,
			max = size,
			strokeSize = 3,
			Parent = fx,
		})
		Kit.tween(t, 1.1, { Position = UDim2.fromOffset(0, 20) })
		task.delay(1.2, function()
			t:Destroy()
		end)
	end

	-- Tutorial objective and a pulsing pointer on the target button.
	local pointer: ImageLabel? = nil
	local shownObjective = ""
	function api.objective(text: string?, target: string?)
		local key = `{text or ""}|{target or ""}`
		if key == shownObjective then
			return -- unchanged: keep the pointer and its pulse thread
		end
		shownObjective = key
		objective.Visible = text ~= nil
		objectiveText.Text = text or ""
		if pointer then
			pointer:Destroy()
			pointer = nil
		end
		local launcher = target and launchers[target]
		local btn: GuiObject? = if target == "Clip"
			then clipBtn
			elseif target == "Post" then postBtn
			elseif launcher then launcher
			else nil
		if btn then
			-- A gold glow in the button's own shape (its white face mask, scaled up and tinted), drawn
			-- behind the button, so the pointer follows the lean exactly.
			local shine = btn:FindFirstChild("Shine")
			local ring = Kit.make("ImageLabel", {
				Name = "Pointer",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = if shine and shine:IsA("ImageLabel") then shine.Image else "",
				ImageColor3 = C.gold,
				ScaleType = Enum.ScaleType.Stretch,
				ZIndex = 0, -- below every HUD group, so it shows only around the button's edge
				Parent = gui,
			})
			pointer = ring
			task.spawn(function()
				while pointer == ring do
					ring.ImageTransparency = if Kit.reduced() then 0 else (math.sin(os.clock() * 6) + 1) / 3
					-- Follow the button on screen (it lives inside a scaled group; this layer does not).
					local size, at = btn.AbsoluteSize, btn.AbsolutePosition
					ring.Visible = btn.Visible and (btn.Parent :: GuiObject).Visible
					ring.Size = UDim2.fromOffset(size.X * 1.1, size.Y * 1.22)
					ring.Position = UDim2.fromOffset(at.X + size.X / 2, at.Y + size.Y * 0.46)
					task.wait(0.05)
				end
			end)
		end
	end

	function api.state(): any
		return last
	end
	api.gui = gui

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	rescale()
	return api
end

return Hud
]]></ProtectedString>
						<string name="ScriptGuid">{74B0DB26-A46D-4E63-9E67-F58BC0344CAC}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Hud</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3b1a6f0ad379c82b0b14bd5600004f4d</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX51AAED9117DA4AB1A0E0E90ED78D5E2E">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Theme and small UI builders. Every screen is made from these.

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")

local Kit = {}

Kit.colors = {
	bg = Color3.fromRGB(20, 14, 36),
	panel = Color3.fromRGB(32, 24, 56),
	card = Color3.fromRGB(46, 36, 78),
	text = Color3.fromRGB(255, 255, 255),
	dim = Color3.fromRGB(196, 186, 226),
	pink = Color3.fromRGB(255, 70, 160),
	green = Color3.fromRGB(60, 220, 120),
	gold = Color3.fromRGB(255, 200, 60),
	blue = Color3.fromRGB(70, 190, 255),
	purple = Color3.fromRGB(170, 100, 255),
	red = Color3.fromRGB(230, 60, 80),
	stroke = Color3.fromHex("160F2B"), -- LihFolk ink: every outline and text stroke
}

-- Same two faces as the LihFolk UI kit, so the HUD and the menus read as one family.
Kit.FONT = Enum.Font.FredokaOne
Kit.BODY = Enum.Font.BuilderSansBold

function Kit.reduced(): boolean
	return Players.LocalPlayer:GetAttribute("ReducedMotion") == true
end

function Kit.make(class: string, props: { [string]: any }, children: { any }?): any
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, c in (children or {}) :: { any } do
		c.Parent = inst
	end
	inst.Parent = props.Parent
	return inst
end

function Kit.corner(r: number): any
	return Kit.make("UICorner", { CornerRadius = UDim.new(0, r) })
end

function Kit.stroke(color: Color3, thickness: number): any
	return Kit.make(
		"UIStroke",
		{ Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }
	)
end

-- Text with a dark outline so it reads on any background.
function Kit.text(props: { [string]: any }): TextLabel
	local t = Kit.make("TextLabel", {
		BackgroundTransparency = 1,
		Font = props.Font or Kit.FONT,
		TextColor3 = props.TextColor3 or Kit.colors.text,
		TextScaled = true,
		TextStrokeTransparency = 1,
		Name = props.Name,
		Text = props.Text or "",
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Center,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	Kit.make("UIStroke", { Color = Kit.colors.stroke, Thickness = props.strokeSize or 2, Parent = t })
	Kit.make("UITextSizeConstraint", { MaxTextSize = props.max or 40, MinTextSize = 21, Parent = t })
	return t
end

local function sound(id: string, speed: number)
	if Players.LocalPlayer:GetAttribute("Sound") == false then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 0.35
	s.PlaybackSpeed = speed
	SoundService:PlayLocalSound(s)
	task.delay(2, s.Destroy, s)
end
-- Built-in client sounds (they ship with every Roblox install, so they always load).
function Kit.click()
	sound("rbxasset://sounds/volume_slider.ogg", 1.25)
end
function Kit.cash()
	sound("rbxasset://sounds/volume_slider.ogg", 1.8)
end
function Kit.big()
	sound("rbxasset://sounds/action_get_up.mp3", 1.2)
end

-- A chunky button with press feedback. Min height is kept at 44 px by the caller's sizes.
function Kit.button(props: { [string]: any }, onClick: () -> ()): (TextButton, TextLabel)
	local b = Kit.make("TextButton", {
		Name = props.Name,
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		BackgroundColor3 = props.color or Kit.colors.pink,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Kit.corner(props.radius or 14), Kit.stroke(Kit.colors.stroke, 3) })
	-- Tactile lip: a darker copy sitting 6 px lower behind the face ("if it has a lip, you can press it").
	local base = props.color or Kit.colors.pink
	Kit.make("Frame", {
		Name = (props.Name or "Button") .. "Lip",
		Size = props.Size,
		Position = (props.Position or UDim2.new()) + UDim2.fromOffset(0, 6),
		AnchorPoint = props.AnchorPoint,
		BackgroundColor3 = base:Lerp(Color3.new(0, 0, 0), 0.45),
		ZIndex = (props.ZIndex or 1) - 1,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { Kit.corner(props.radius or 14), Kit.stroke(Kit.colors.stroke, 3) })
	Kit.make("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		Rotation = 90,
		Parent = b,
	})
	local label = Kit.text({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		max = props.max or 34,
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = b,
	})
	label.Name = "Label"
	local scale = Kit.make("UIScale", { Parent = b })
	b.Activated:Connect(function()
		Kit.click()
		if not Kit.reduced() then
			scale.Scale = 0.9
			TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		onClick()
	end)
	return b, label
end

-- A button drawn by an uploaded image (outline, lip and icon are in the art; the label is live text).
-- Same press bounce and click sound as Kit.button; Selectable for gamepad focus.
function Kit.imageButton(
	props: { [string]: any },
	art: { id: string, aspect: number, label: { number }?, mask: string? },
	onClick: () -> ()
): ImageButton
	local b = Kit.make("ImageButton", {
		Name = props.Name,
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		BackgroundTransparency = 1,
		Image = art.id,
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Kit.make("UIAspectRatioConstraint", { AspectRatio = art.aspect }) })
	-- Live label in the art's label box: white Luckiest Guy, ink outline, ink drop shadow.
	local area = art.label
	if props.Label and area then
		local box = Kit.make("Frame", {
			Name = "LabelBox",
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(area[1], area[2]),
			Size = UDim2.fromScale(area[3] - area[1], area[4] - area[2]),
			ZIndex = (props.ZIndex or 1) + 1,
			Parent = b,
		})
		local labels: { TextLabel } = {}
		for _, shadow in { true, false } do
			local t = Kit.text({
				Name = if shadow then "LabelShadow" else "Label",
				Text = props.Label,
				Font = Enum.Font.LuckiestGuy,
				TextColor3 = if shadow then Kit.colors.stroke else Color3.new(1, 1, 1),
				Size = UDim2.fromScale(1, 1),
				Position = if shadow then UDim2.fromScale(0, 0.09) else UDim2.new(),
				max = props.LabelMax or 60,
				strokeSize = 3,
				ZIndex = (props.ZIndex or 1) + (if shadow then 1 else 2),
				Parent = box,
			})
			t.TextYAlignment = Enum.TextYAlignment.Center
			table.insert(labels, t)
		end
		-- One line, as large as the box allows (never below 21 design px, which is 12 px on a phone).
		-- TextScaled would wrap "GO VIRAL" on phones; with wrapping off it under-sizes on PC.
		-- Sized from the button's design size (its offsets), so hover and press bounces never re-fit it.
		local design: UDim2 = props.Size
		local w = design.X.Offset * (area[3] - area[1])
		local h = math.min(design.Y.Offset, design.X.Offset / art.aspect) * (area[4] - area[2])
		local size = math.min(props.LabelMax or 60, math.floor(h * 0.9))
		while size > 21 do
			local bounds =
				TextService:GetTextSize(props.Label, size, Enum.Font.LuckiestGuy, Vector2.new(1e4, 1e4))
			if bounds.X <= w * 0.96 then
				break
			end
			size -= 1
		end
		for _, t in labels do
			t.TextScaled = false
			t.TextWrapped = false
			t.TextSize = size
		end
	end
	-- Shine: a soft white band sweeps across the face, drawn through a white mask of the plate so
	-- it never spills past the outline. Every `props.Shine` seconds, and on hover. Off under Reduced Motion.
	local sweep: (() -> ())? = nil
	if art.mask then
		local shine = Kit.make("ImageLabel", {
			Name = "Shine",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = art.mask,
			ScaleType = Enum.ScaleType.Fit,
			ImageTransparency = 1,
			ZIndex = (props.ZIndex or 1) + 1,
			Parent = b,
		})
		local grad = Kit.make("UIGradient", {
			Rotation = 20,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 1),
				NumberSequenceKeypoint.new(0.5, 0.45),
				NumberSequenceKeypoint.new(0.58, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Offset = Vector2.new(-1, 0),
			Parent = shine,
		})
		local running = false
		sweep = function()
			if running or Kit.reduced() then
				return
			end
			running = true
			shine.ImageTransparency = 0
			grad.Offset = Vector2.new(-1, 0)
			local t = TweenService:Create(
				grad,
				TweenInfo.new(0.7, Enum.EasingStyle.Sine),
				{ Offset = Vector2.new(1, 0) }
			)
			t.Completed:Once(function()
				shine.ImageTransparency = 1
				running = false
			end)
			t:Play()
		end
		if props.Shine then
			task.spawn(function()
				while b.Parent do
					task.wait(props.Shine)
					if b.Visible then
						(sweep :: () -> ())()
					end
				end
			end)
		end
	end

	local scale = Kit.make("UIScale", { Parent = b })
	local hovered, pulse = false, nil :: RBXScriptConnection?
	b.Activated:Connect(function()
		Kit.click()
		if not Kit.reduced() then
			scale.Scale = 0.9
			TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		onClick()
	end)
	b.MouseEnter:Connect(function()
		hovered = true
		if not Kit.reduced() then
			TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.05 }):Play()
			if sweep then
				sweep()
			end
		end
	end)
	b.MouseLeave:Connect(function()
		hovered = false
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	-- Attribute "Pulse" = true makes the button breathe (used for POST when the drive is full).
	b:GetAttributeChangedSignal("Pulse"):Connect(function()
		local on = b:GetAttribute("Pulse") == true
		if on and not pulse then
			local t0 = os.clock()
			pulse = RunService.RenderStepped:Connect(function()
				if not hovered and not Kit.reduced() then
					scale.Scale = 1 + 0.05 * math.abs(math.sin((os.clock() - t0) * 4))
				end
			end)
		elseif not on and pulse then
			pulse:Disconnect()
			pulse = nil
			scale.Scale = 1
		end
	end)
	return b
end

function Kit.tween(inst: Instance, time: number, goal: { [string]: any })
	if Kit.reduced() then
		for k, v in goal do
			(inst :: any)[k] = v
		end
		return
	end
	TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
		:Play()
end

return Kit
]]></ProtectedString>
						<string name="ScriptGuid">{60231C42-74F9-4C9A-836C-276FE73208FF}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Kit</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3b1a6f0ad379c82b0b14bd5600004f4f</UniqueId>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX3177F768081E409DBFF6AFED50D078EB">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Client entry: renders server state, batches taps, runs the 3-step tutorial, and makes locked
-- gates solid for this player only. It never grants value; the server decides everything.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Hud = require(script.Parent.Hud)
local Kit = require(script.Parent.Kit)

local pendingTaps = 0
local tutorialSent = false -- server state can lag one push behind the tutorialDone act
local state: any = nil
local hud

local function act(action: string, arg: any?)
	task.spawn(function()
		local ok, result, why = pcall(function()
			return Remotes.Act:InvokeServer(action, arg)
		end)
		if not ok then
			hud.toast("Connection hiccup. Try again", "error")
		elseif not result and why then
			hud.toast(why, "error")
		end
	end)
end

-- Device-aware wording: the same step reads "Tap" on touch, "Press R2" on a gamepad, "Click" on PC.
-- Follows the input the player is using right now (the kit reads PreferredInput), so one HUD rule for all.
local KitController = require(ReplicatedStorage:WaitForChild("LihFolkUI"):WaitForChild("LihFolkUIController"))
local function device(): string
	local input = KitController.preferredInput()
	return if input == "Touch" then "touch" elseif input == "Gamepad" then "pad" else "pc"
end
local WORDS = {
	clip = {
		touch = "Tap CLIP to record clips",
		pad = "Press R2 to record clips",
		pc = "Click CLIP or press E",
	},
	post = { touch = "Tap POST to sell clips", pad = "Press X to sell clips", pc = "Click POST or press Q" },
	full = { touch = "Drive full! Tap POST", pad = "Drive full! Press X", pc = "Drive full! Click POST" },
}

local lastFullToast = 0
local function tap()
	if not state then
		return
	end
	if state.clips >= state.capacity then
		if os.clock() - lastFullToast > 1.5 then
			lastFullToast = os.clock()
			hud.toast(WORDS.full[device()], "error")
		end
		return
	end
	pendingTaps += 1
	-- Show the clip right away; the next server state corrects any difference.
	state.clips = math.min(state.capacity, state.clips + state.tapPower)
	hud.updateClips(state)
	hud.float(`+{Format.short(state.tapPower)} clip`, Kit.colors.pink, 36)
end

local tutorial: () -> () -- defined below; the skip action calls it

hud = Hud.build({
	tap = tap,
	post = function()
		act("post")
	end,
	buy = function(id)
		act("buy", id)
	end,
	rebirth = function()
		act("rebirth")
	end,
	setting = function(name)
		act("setting", name)
	end,
	skipTutorial = function()
		tutorialSent = true
		act("tutorialDone", "skip")
		if state then
			state.tutorialSent = true
			hud.update(state)
			tutorial()
		end
	end,
})

-- Tutorial: three steps, each one verb and one target. Ends after the first upgrade.
function tutorial()
	if not state or state.tutorialDone or tutorialSent then
		local nextZone = Config.ZONES[(state and state.unlocked or 1) + 1]
		if nextZone and state then
			hud.objective(
				`Next setup: {Format.short(state.followers)} / {Format.short(nextZone.followers)} followers`,
				nil
			)
		else
			hud.objective(nil, nil)
		end
		return
	end
	local goal = math.min(10, state.capacity)
	local cost = state.costs.tapPower
	local d = device()
	if state.levels.tapPower > 0 then
		tutorialSent = true
		act("tutorialDone")
		hud.toast("Nice! Followers open new setups", "info")
		tutorial()
	elseif state.cash >= cost then
		hud.objective("Buy Tap Power in Upgrades", "Upgrades")
	elseif state.clips >= goal or (state.cash > 0 and state.clips > 0) then
		hud.objective(WORDS.post[d], "Post")
	else
		hud.objective(WORDS.clip[d], "Clip")
	end
end

-- Locked gates are solid and lit for this player only.
local world: Instance? = nil -- set once the server has built the street (see end of file)
local function gates()
	if not state or not world then
		return
	end
	for i = 2, #Config.ZONES do
		local g = world:FindFirstChild(`Gate{i}`)
		-- lihfolk-ignore: findfirstchild-chain (nil-checked below)
		local wall = g and g:FindFirstChild("Wall") :: BasePart?
		if wall then
			local locked = i > state.unlocked
			wall.CanCollide = locked
			wall.Transparency = if locked then 0.2 else 1
			-- lihfolk-ignore: findfirstchild-chain (nil-checked below)
			local lock = wall:FindFirstChild("Lock") :: BillboardGui?
			if lock then
				lock.Enabled = locked
			end
		end
	end
end

Remotes.State.OnClientEvent:Connect(function(view)
	local first = state == nil
	state = view
	state.tutorialSent = tutorialSent
	state.clips = math.min(state.capacity, state.clips + pendingTaps * state.tapPower) -- taps not yet sent
	hud.update(state)
	tutorial()
	gates()
	if first then
		hud.toast(`Clip the {Config.HYPE_GAME} hype!`, "info")
	end
end)

Remotes.Toast.OnClientEvent:Connect(function(text, kind)
	hud.toast(text, kind)
end)

Remotes.Celebrate.OnClientEvent:Connect(function(kind, data)
	if kind == "post" then
		Kit.cash()
		if data.viral then
			Kit.big()
			hud.float(`VIRAL! x{Config.VIRAL_MULT}  +{Format.money(data.cash)}`, Kit.colors.gold, 64)
		else
			hud.float(
				if data.followers >= 1
					then `+{Format.money(data.cash)}   +{Format.short(data.followers)} followers`
					else `+{Format.money(data.cash)}`, -- fractional followers still count, just not shown
				Kit.colors.green,
				44
			)
		end
	elseif kind == "zone" then
		Kit.big()
		local z = Config.ZONES[data.index]
		hud.toast(`{z.name} open! Clips pay x{z.mult}`, "hype")
	elseif kind == "rebirth" then
		Kit.big()
		hud.float(`YOU WENT VIRAL! Clout {data.clout}`, Kit.colors.purple, 60)
	end
end)

-- Taps leave in small batches; the server caps the count.
task.spawn(function()
	while true do
		task.wait(0.4)
		if pendingTaps > 0 then
			local n = math.min(pendingTaps, Config.TAP_BATCH_MAX)
			pendingTaps -= n
			Remotes.Tap:FireServer(n)
		end
	end
end)

-- Keyboard and gamepad: E / R2 clip, Q / X post.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local k = input.KeyCode
	if k == Enum.KeyCode.E or k == Enum.KeyCode.ButtonR2 then
		tap()
	elseif k == Enum.KeyCode.Q or k == Enum.KeyCode.ButtonX then
		act("post")
	end
end)

-- Hype countdown ticks locally between server states (the server clock is the truth).
task.spawn(function()
	while true do
		task.wait(1)
		if state and state.hypeLeft > 0 then
			state.hypeLeft -= 1
			hud.update(state)
		end
	end
end)

task.spawn(function()
	world = workspace:WaitForChild("World")
	gates()
end)
]]></ProtectedString>
						<bool name="Disabled">false</bool>
